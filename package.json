{
  "name": "peer-to-peer-chess",
  "description": "This project is for showing up a whole chess game fullstack setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.1",
  "author": {
    "name": "Marco Baldi",
    "email": "marcobaldi1997@gmail.com",
    "url": "https://github.com/marcobaldi97"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "postinstall": "node scripts/sync-stockfish.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.0",
    "react-dom": "^19.2.8",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "1.6.1",
    "@vitest/ui": "^1.6.1",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.9",
    "prettier": "3.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.1"
  }
}
