# Base URL of the save-game backend API (see server/). Defaults to
# http://localhost:3000 in the app when this is not set.
VITE_API_URL=http://localhost:3000

# AWS Cognito, for signing in with email/password or Google. All three come
# from the OpenTofu outputs in server/infra (cognito_issuer_url,
# cognito_user_pool_client_id and cognito_hosted_ui_domain respectively).
#
# When any of these is unset, the sign-in control and the save-game form are
# hidden and the rest of the app works normally — so you can run the app
# locally without any AWS setup.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
